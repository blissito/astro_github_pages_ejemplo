{
  "name": "tts-app",
  "version": "1.0.0",
  "description": "Text-to-Speech application with AI enhancement",
  "main": "server/index.js",
  "scripts": {
    "dev": "npm run build:client && nodemon server/index.js",
    "start": "node server/index.js",
    "build": "npm run build:client || echo 'Frontend build skipped'",
    "build:client": "cd client && npm run build",
    "setup": "npm install && cd client && npm install && cd .. && npm run init-db",
    "init-db": "node scripts/init-db.js",
    "migrate": "node database/migrate.js",
    "seed": "node database/seed.js",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "jest --testPathPattern=server",
    "test:frontend": "cd client && npm test",
    "lint": "eslint . --ext .js,.jsx",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\""
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^6.2.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.0.1",
    "multer": "^1.4.5-lts.1",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
